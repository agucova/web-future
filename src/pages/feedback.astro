---
import Layout from '../layouts/Layout.astro';
import { TURNSTILE_SITE_KEY } from '$lib/feedback/config';

const title = "Feedback";
const description = "Send me anonymous, end-to-end encrypted feedback.";
---

<!-- minimal: no third-party scripts may share this DOM with the plaintext
     textarea (they could read the message before encryption). -->
<Layout title={title} description={description} minimal>
    <h1>{title}</h1>

    <p>
        This form is <strong>anonymous by construction</strong>: your message
        is encrypted in your browser to my public key, so I can't tell who
        sent it, and the server never sees plaintext.
    </p>

    <details>
        <summary>How it works</summary>
        <p>
            The page encrypts your message with
            <a href="https://age-encryption.org" rel="noopener noreferrer"
                >age</a
            > before it leaves your browser. The server only accepts
            ciphertext, stores nothing, doesn't record your IP address, and
            relays the encrypted message straight to my inbox, where only I
            can decrypt it. The
            <a
                href="https://github.com/agucova/web-future"
                rel="noopener noreferrer">code is public</a
            > (though, as with anything E2EE on the web, you're ultimately
            trusting the code this site serves you).
        </p>
        <p>
            Since it's anonymous, I can't reply, so include contact info if
            you'd like a response. Messages relay in real time, so I can see
            roughly <em>when</em> one arrives; if that timing alone could
            identify you, hold your message and send it later.
        </p>
    </details>

    <noscript>
        <p>
            <strong>This form needs JavaScript.</strong> The encryption
            happens in your browser, so there's no way around it. If you'd
            rather not enable it, you can PGP-encrypt an email to me instead
            (see <a href="/pgp">/pgp</a>).
        </p>
    </noscript>

    <form id="feedback-form" hidden>
        <label for="about">Who or what is this about? (optional)</label>
        <input
            type="text"
            id="about"
            name="about"
            maxlength="200"
            placeholder="e.g. a talk I gave, Kairos, me in general"
        />

        <label for="message">Your feedback</label>
        <textarea
            id="message"
            name="message"
            rows="8"
            maxlength="10000"
            required
            placeholder="Say anything. I mean it."></textarea>

        <div class="hp-field" aria-hidden="true">
            <label for="website">Leave this field empty</label>
            <input
                type="text"
                id="website"
                name="website"
                tabindex="-1"
                autocomplete="off"
            />
        </div>

        <!-- Turnstile, kept low profile: with appearance=interaction-only the
             widget stays invisible unless Cloudflare needs the visitor to
             interact (rare); the token is fetched silently in the background. -->
        <div
            class="cf-turnstile"
            data-sitekey={TURNSTILE_SITE_KEY}
            data-appearance="interaction-only"
            data-theme="auto"></div>

        <button type="submit" id="feedback-submit">Send anonymously</button>
    </form>

    <p id="feedback-status" role="status" aria-live="polite"></p>

    <script
        is:inline
        src="https://challenges.cloudflare.com/turnstile/v0/api.js"
        async
        defer></script>

    <script>
        import { Encrypter, armor } from "age-encryption";
        import { AGE_RECIPIENT } from "$lib/feedback/config";

        const form = document.getElementById(
            "feedback-form",
        ) as HTMLFormElement;
        const status = document.getElementById(
            "feedback-status",
        ) as HTMLParagraphElement;
        const submitButton = document.getElementById(
            "feedback-submit",
        ) as HTMLButtonElement;

        // The form is hidden by default so that no-JS visitors see the
        // <noscript> explanation instead of a form that can't work.
        form.hidden = false;

        function setStatus(message: string) {
            status.textContent = message;
        }

        form.addEventListener("submit", async (event) => {
            event.preventDefault();

            const data = new FormData(form);
            const message = String(data.get("message") ?? "").trim();
            const about = String(data.get("about") ?? "").trim();
            const honeypot = String(data.get("website") ?? "");

            if (!message) {
                setStatus("Please write a message first.");
                return;
            }

            // Fail loud on a filled honeypot: browser autofill occasionally
            // populates hidden fields, and a silent server-side drop would
            // destroy a real person's message without them knowing.
            if (honeypot !== "") {
                setStatus(
                    "A hidden anti-spam field got filled in, probably by browser autofill. Nothing was sent. Please reload the page and try again.",
                );
                return;
            }

            // The Turnstile token is normally fetched invisibly in the
            // background; if it isn't ready yet, wait for it briefly rather
            // than bothering the visitor about a widget they can't see.
            let turnstileToken = String(
                new FormData(form).get("cf-turnstile-response") ?? "",
            );
            if (!turnstileToken) {
                setStatus("Checking you're human…");
                for (let i = 0; i < 60 && !turnstileToken; i++) {
                    await new Promise((resolve) => setTimeout(resolve, 250));
                    turnstileToken = String(
                        new FormData(form).get("cf-turnstile-response") ?? "",
                    );
                }
                if (!turnstileToken) {
                    setStatus(
                        "The human check didn't complete. If a challenge appeared below, please finish it and submit again.",
                    );
                    return;
                }
            }

            submitButton.disabled = true;
            setStatus("Encrypting…");

            try {
                const plaintext = about
                    ? `About: ${about}\n\n${message}`
                    : message;

                const encrypter = new Encrypter();
                encrypter.addRecipient(AGE_RECIPIENT);
                const ciphertext = armor.encode(
                    await encrypter.encrypt(plaintext),
                );

                if (ciphertext.length > 28_000) {
                    setStatus(
                        "That message is too long to send. Please trim it down.",
                    );
                    submitButton.disabled = false;
                    return;
                }

                setStatus("Sending…");
                const response = await fetch("/api/feedback", {
                    method: "POST",
                    headers: { "content-type": "application/json" },
                    body: JSON.stringify({
                        ciphertext,
                        turnstileToken,
                        website: honeypot,
                    }),
                });

                if (response.status === 204) {
                    form.reset();
                    form.hidden = true;
                    setStatus(
                        "Sent! Your encrypted message is on its way. Thank you, I read everything.",
                    );
                } else {
                    let detail = "";
                    try {
                        const body = (await response.json()) as {
                            error?: string;
                        };
                        detail = body.error ?? "";
                    } catch {
                        /* non-JSON error body */
                    }
                    setStatus(
                        detail
                            ? `Something went wrong: ${detail}`
                            : `Something went wrong (HTTP ${response.status}). Please try again.`,
                    );
                }
            } catch (error) {
                console.error(error);
                setStatus(
                    "Something went wrong on this page (nothing was sent). Please try again.",
                );
            } finally {
                submitButton.disabled = false;
                // Turnstile tokens are single-use; get a fresh one for retries.
                window.turnstile?.reset();
            }
        });
    </script>

    <style>
        form label {
            display: block;
            margin-top: 1em;
        }

        form input[type="text"],
        form textarea {
            width: 100%;
            box-sizing: border-box;
        }

        .cf-turnstile {
            margin-top: 1em;
        }

        form button[type="submit"] {
            display: block;
            margin-top: 1.25em;
            padding: 0.6em 1.5em;
            background: transparent;
            color: var(--links, #3b82c4);
            border: 1px solid
                color-mix(in srgb, var(--links, #3b82c4) 50%, transparent);
            border-radius: 6px;
            font-size: 1rem;
            font-weight: 600;
            cursor: pointer;
            transition:
                background-color 0.15s ease,
                border-color 0.15s ease,
                transform 0.05s ease;
        }

        form button[type="submit"]:hover {
            background: color-mix(
                in srgb,
                var(--links, #3b82c4) 12%,
                transparent
            );
            border-color: var(--links, #3b82c4);
        }

        form button[type="submit"]:active {
            transform: translateY(1px);
        }

        form button[type="submit"]:focus-visible {
            outline: 2px solid var(--focus, #7dbaff);
            outline-offset: 2px;
        }

        form button[type="submit"]:disabled {
            opacity: 0.6;
            cursor: default;
            filter: none;
        }

        /* Honeypot: visually removed, but still present for bots that
           fill in every field. Real users never see or focus it. */
        .hp-field {
            position: absolute;
            left: -9999px;
            width: 1px;
            height: 1px;
            overflow: hidden;
        }
    </style>
</Layout>
