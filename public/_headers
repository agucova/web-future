/*
  Content-Security-Policy: default-src 'self' 'unsafe-inline' 'unsafe-eval' https://cloudflareinsights.com https://static.cloudflareinsights.com https://*.fontawesome.com https://fonts.googleapis.com https://fonts.gstatic.com https://assets.calendly.com https://calendly.com https://embed.savvycal.com https://challenges.cloudflare.com https://*.basemaps.cartocdn.com https://*.carto.com; frame-src https://calendly.com https://savvycal.com https://challenges.cloudflare.com; img-src 'self' data: https://*.basemaps.cartocdn.com https://*.carto.com https://*.openstreetmap.org; media-src 'self'

# /feedback handles plaintext-before-encryption in the DOM: only Turnstile
# may load beside first-party code. Both this policy and /* apply (browsers
# enforce the intersection, which equals this stricter one). The splat also
# covers the trailing-slash form the asset server redirects to.
/feedback*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; connect-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; img-src 'self' data:; base-uri 'none'; form-action 'self'; frame-ancestors 'none'
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
