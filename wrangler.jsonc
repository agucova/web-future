// Cloudflare Worker serving the whole site: the static Astro build (dist/)
// plus dynamic endpoints (POST /api/feedback, GET /api/now-playing,
// GET /api/where).
//
// The agucova.dev custom domain is attached to this Worker in the Cloudflare
// dashboard rather than declared here, and pushes to main deploy through
// Workers Builds (see DEPLOY.md).
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "agucova-dev",
	"main": "src/worker/index.ts",
	"compatibility_date": "2026-08-01",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		// No "not_found_handling": the Astro build has no 404.html, so the
		// default (plain 404 response) applies. If a 404 page is added
		// later, set "not_found_handling": "404-page".
		//
		// Astro builds with `trailingSlash: 'never'` and emits
		// dist/<page>/index.html. The asset server's default
		// ("auto-trailing-slash") would make /now/ the canonical URL and
		// redirect /now to it, which contradicts every canonical link and nav
		// href the site emits, and would land agents on a path that is not
		// Worker-first and therefore never negotiates.
		"html_handling": "drop-trailing-slash",
		//
		// Worker-first routing, as an array rather than `true`: only the
		// pages that negotiate between HTML and their markdown twin, plus
		// the API. `true` would route every /_astro/* chunk, stylesheet and
		// image through the Worker, turning free asset requests into billed
		// invocations. The list is generated from the page registry in
		// src/lib/agents/pages.ts and asserted by tests/agents-pages.test.ts,
		// which prints the expected list when it drifts.
		"run_worker_first": ["/", "/now", "/where", "/uses", "/pgp", "/keys", "/feedback", "/api/*"]
	},
	// Email Sending binding used by /api/feedback. The from-domain
	// (agucova.dev) must be onboarded via `wrangler email sending enable
	// agucova.dev` before feedback delivery works.
	"send_email": [
		{
			"name": "EMAIL",
			"allowed_sender_addresses": ["feedback@agucova.dev"],
			"allowed_destination_addresses": ["agucova@gmail.com"]
		}
	],
	// Cache behind GET /api/now-playing (see docs/spotify-setup.md): holds the
	// Spotify access token and the shaped response, so Spotify is called once
	// per cache window instead of once per visitor. Every visitor gets the
	// same JSON, so nothing visitor-specific is ever stored here.
	"kv_namespaces": [
		{
			"binding": "NOW_PLAYING",
			"id": "9cc79d836a0d48dd945e49e8f805acd6"
		},
		// Opt-in gate and DNS answer cache behind GET /api/where (see
		// docs/where-setup.md). Separate from NOW_PLAYING on purpose: the
		// location switch and the Spotify ghost switch are different
		// decisions with opposite defaults, and neither may be able to reach
		// the other's key. Holds no visitor data.
		{
			"binding": "WHERE",
			"id": "5b823210670b45859e1295ca5c221faf"
		}
	],
	// Observability stays disabled on purpose: the feedback endpoint must
	// not record anything about senders, and Workers Logs would capture
	// invocation metadata. Do not enable.
	"observability": {
		"enabled": false
	}
}
